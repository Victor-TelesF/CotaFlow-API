# Valores fictícios, somente para desenvolvimento local.
DB_DRIVER=postgresql+psycopg
# Conexão da API executada no host; o Compose usa db:5432 para a API.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=app
DB_USER=app
DB_PASSWORD=dev_password

# Gere uma chave privada com: uv run --locked python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Guarde a saída somente no .env local ou no gerenciador de segredos do ambiente.
# A API não inicia com este campo vazio nem com o placeholder antigo.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30

# CORS: lista JSON de origens EXATAS, sem barra final; reinicie após alterar.
# Exemplo fictício: ["https://seu-projeto.vercel.app","http://localhost:5173"]
# Vazio até definir o frontend. JWT usa Authorization; cookies não são aceitos.
CORS_ALLOW_ORIGINS=[]
# Espera pelo lock de migrations antes de falhar o startup (1 a 300 segundos).
MIGRATION_LOCK_TIMEOUT_SECONDS=30
# TLS remoto é configurado por PGSSLMODE=verify-full e PGSSLROOTCERT da libpq.
# Defina ambos no ambiente de execução, com CA/hostname verificados do provedor.
# Este exemplo/Compose usa PostgreSQL local; não comprova TLS de Render/Neon.

# Limites por processo: tentativas admitidas, inclusive sucesso e erro.
AUTH_REGISTER_PER_10_MINUTES=5
AUTH_LOGIN_PER_MINUTE=20
AUTH_LOGIN_PAIR_PER_5_MINUTES=5
AUTH_MAX_CONCURRENT=2
# Tentativas de compra/venda por usuário e processo, inclusive erros de domínio.
PORTFOLIO_TRANSACTIONS_PER_MINUTE=30
# Vazio: headers de proxy não mudam o peer no CMD da imagem.
# Configure somente IPs/redes de proxies cuja cadeia/ingresso foram verificados.
# Nunca use *; sem cadeia validada, clientes atrás do mesmo proxy dividem quota.
FORWARDED_ALLOW_IPS=

# brapi: cotações básicas para avaliação, com cache local de 30 minutos.
# Obtenha o token em https://brapi.dev/dashboard e preencha somente no .env local.
# Informe só o token, sem o prefixo Bearer; mantenha este exemplo sem segredo real.
BRAPI_TOKEN=
# Limites por processo: reiniciam com a API e não garantem franquia mensal.
MARKET_MAX_TICKERS=20
MARKET_VALUATIONS_PER_MINUTE=10
MARKET_EXTERNAL_CALLS_PER_MINUTE=30

# Portas publicadas no host, sempre em 127.0.0.1.
DB_HOST_PORT=55432
API_HOST_PORT=8000
