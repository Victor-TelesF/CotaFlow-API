# Valores fictícios, somente para desenvolvimento local.
DB_DRIVER=postgresql+psycopg
# Conexão da API executada no host; o Compose usa db:5432 para a API.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=app
DB_USER=app
DB_PASSWORD=dev_password

# Substitua por uma chave aleatória própria; este valor é fictício.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=30

# Portas publicadas no host, sempre em 127.0.0.1.
DB_HOST_PORT=55432
API_HOST_PORT=8000
